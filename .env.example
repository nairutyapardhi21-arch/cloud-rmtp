# Copy to .env. Never commit the populated file.
DATABASE_URL=postgresql://restreamer:change-me@postgres:5432/restreamer?schema=public
POSTGRES_PASSWORD=change-me-before-demo
API_PORT=3001
RTMP_INTERNAL_URL=rtmp://nginx/live
PUBLIC_RTMP_URL=rtmp://localhost/live
INTERNAL_INGEST_TOKEN=replace-with-a-long-random-value
AWS_REGION=ap-south-1
# Optional local secret fallbacks. In AWS set SECRET_REFERENCE on a destination instead.
YOUTUBE_RTMP_URL=
TWITCH_RTMP_URL=
LINKEDIN_RTMP_URL=
